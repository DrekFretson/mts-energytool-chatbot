# Без LLM_BASE_URL поднимается заглушка fake-llm: интерфейс работает, ответы ненастоящие.
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3.8-27b
# EMB_MODEL=baai/bge-m3
# Эмбеддинги с другого сервера, например bge-m3 на своей машине. По умолчанию LLM_BASE_URL.
# EMB_BASE_URL=http://host.docker.internal:8081/v1
# EMB_API_KEY=
# RERANKER_MODEL=qwen/qwen3-reranker-8b
# Только для OpenRouter: фиксированный провайдер, например deepinfra/bf16
# LLM_PROVIDER=

# Открывает режим отладки и /admin. Пустой токен отключает их полностью.
DEBUG_TOKEN=change-me
PORT=8000
